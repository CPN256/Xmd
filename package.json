{
  "name": "cat-cpn-downloads",
  "version": "1.0.0",
  "private": true,
  "description": "CAT CPN Downloads - a modern digital download library with an Express and MongoDB API.",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"nodemon server/index.js\" \"npm --prefix admin run dev\"",
    "start": "node server/index.js",
    "build:admin": "npm --prefix admin run build",
    "install:all": "npm install && npm --prefix admin install",
    "check": "node --check server/index.js && node --check server/routes/downloads.js && node --check server/routes/auth.js",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
